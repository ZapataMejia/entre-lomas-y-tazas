---
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { rutas } from "../../data/rutas";
import { capitulosDetalle } from "../../data/capitulos-detalle";
import { imagenesPcc } from "../../data/imagenesPcc";
import { navIndiceDesdeLibro } from "../../lib/nav-indice";

export function getStaticPaths() {
  return [1, 2, 3, 4, 5, 6, 7, 8].map((num) => ({ params: { num: String(num) } }));
}

const num = Number(Astro.params.num);
if (!Number.isInteger(num) || num < 1 || num > 8) {
  return Astro.redirect("/");
}

const { meta, guia, indiceLibro, ideas } = rutas;
const nombreSitio = meta.titulo ?? "Antes de que se nos olvide";
const detalle = capitulosDetalle[num - 1];
const entradaIndice = indiceLibro.find((e) => e.num === num);
const color = entradaIndice?.color ?? "#153a5c";
const tituloOficial = entradaIndice?.titulo ?? `Capítulo ${num}`;
const illo = imagenesPcc.capitulos[num - 1];

const pageTitle = `Cap. ${num} · ${tituloOficial} · ${nombreSitio}`;
const pageDescription = detalle
  ? `${tituloOficial}: ${detalle.resumen}`
  : `${tituloOficial} — cuaderno PCC`;

const navIndice = navIndiceDesdeLibro(indiceLibro);
const navLinks = [
  { label: "Intro", href: "/#introduccion" },
  { label: "Índice", href: "/#indice" },
  { label: "Capítulos", href: "/#capitulos" },
  { label: "Municipios", href: "/#municipios" },
  { label: "Bitácora", href: "/#bitacora" },
];

const year = new Date().getFullYear();
const officialFootLinks = [
  { label: "Portal Paisaje Cultural Cafetero", href: "https://paisajeculturalcafetero.org.co/", external: true },
  { label: "Listado UNESCO", href: "https://whc.unesco.org/en/list/1121/", external: true },
];
const siteFootLinks = [
  { label: "Portada", href: "/" },
  { label: "Índice del folleto", href: "/#indice" },
  { label: "Mapa municipios", href: "/#municipios" },
  { label: "Bitácora", href: "/#bitacora" },
];

const mapaRutas = meta.enlaceMapa;
---

<Layout title={pageTitle} description={pageDescription} ogImage={illo.src}>
  <a class="pcc-skip" href="#cap-contenido">Saltar al contenido</a>

  <SiteHeader brand={nombreSitio} brandHref="/" links={navLinks} chapterLinks={navIndice} ctaLabel="Bitácora" ctaHref="/#bitacora" />

  <main class="pcc-cap-page" id="cap-contenido" style={`--accent: ${color}; --cap-accent: ${color}`}>
    <div class="pcc-cap-page__mast">
      <img src={illo.src} alt={illo.alt} width="1600" height="900" loading="eager" decoding="async" referrerpolicy="no-referrer" />
    </div>

    <div class="pcc-container pcc-cap-page__wrap">
      <nav class="pcc-cap-page__crumb" aria-label="Ruta">
        <a href="/">Inicio</a>
        <span aria-hidden="true"> / </span>
        <a href="/#capitulos">Capítulos</a>
        <span aria-hidden="true"> / </span>
        <span>Cap. {num}</span>
      </nav>

      <header class="pcc-cap-page__head">
        <span class="pcc-kicker pcc-kicker--accent">Capítulo {num}</span>
        <h1 class="pcc-cap-page__h">{tituloOficial}</h1>
        <p class="pcc-prose pcc-cap-page__lead">{detalle.introduccion}</p>
      </header>

      {
        detalle.secciones.map((sec, si) => (
          <section class="pcc-cap-page__section" aria-labelledby={`cap-${num}-sec-${si}`}>
            <h2 class="pcc-cap-page__h2" id={`cap-${num}-sec-${si}`}>
              {sec.titulo}
            </h2>
            {sec.texto?.map((p) => <p class="pcc-prose">{p}</p>)}
            {sec.lista && (
              <ul class="pcc-ul pcc-ul--check">
                {sec.lista.map((li) => (
                  <li>{li}</li>
                ))}
              </ul>
            )}
          </section>
        ))
      }

      {
        num === 8 && (
          <section class="pcc-cap-page__section" aria-labelledby="cap8-extra">
            <h2 class="pcc-cap-page__h2" id="cap8-extra">
              Nota del cuaderno (mesa y mercados)
            </h2>
            <p class="pcc-prose">{guia.cocinaTradicional}</p>
          </section>
        )
      }

      {
        num === 5 && (
          <section class="pcc-cap-page__section" aria-labelledby="cap5-ideas">
            <h2 class="pcc-cap-page__h2" id="cap5-ideas">
              Próximas paradas (ideas)
            </h2>
            <ul class="pcc-rutas pcc-rutas--cards">
              {ideas.length === 0 ? (
                <li class="pcc-rutas__empty">Todavía no hay pueblos en la lista; cuando anoten uno en el código, aparece acá.</li>
              ) : (
                ideas.map((it) => (
                  <li class="pcc-ruta-card">
                    <strong>{it.municipio}</strong>
                    {it.departamento && <span class="pcc-ruta-card__depto">{it.departamento}</span>}
                    {it.detalle && <p class="pcc-ruta-card__d">{it.detalle}</p>}
                  </li>
                ))
              )}
            </ul>
            {mapaRutas && (
              <p class="pcc-prose">
                <a class="pcc-a" href={mapaRutas.url} target="_blank" rel="noopener noreferrer">
                  {mapaRutas.etiqueta} ↗
                </a>
              </p>
            )}
          </section>
        )
      }

      {
        num === 6 && (
          <section class="pcc-cap-page__section" aria-labelledby="cap6-muni">
            <h2 class="pcc-cap-page__h2" id="cap6-muni">
              Municipios en el sitio
            </h2>
            <p class="pcc-prose">
              El listado interactivo con fichas está en la{" "}
              <a class="pcc-a" href="/#municipios">
                portada — sección Municipios
              </a>
              .
            </p>
            <div class="pcc-grid pcc-grid--tight">
              {guia.territorio.map((d) => (
                <div class="pcc-card pcc-card--lift">
                  <h3 class="pcc-card__h">{d.nombre}</h3>
                  <p class="pcc-card__p">{d.resumen}</p>
                </div>
              ))}
            </div>
          </section>
        )
      }

      {
        num === 7 && (
          <section class="pcc-cap-page__section" aria-label="Lista breve de consejos del cuaderno">
            <ul class="pcc-tips pcc-tips--cards">
              {guia.consejosPracticos.map((c) => (
                <li>{c}</li>
              ))}
            </ul>
          </section>
        )
      }

      {
        detalle.enlacesUtiles && detalle.enlacesUtiles.length > 0 && (
          <section class="pcc-cap-page__section" aria-labelledby={`cap-enlaces-${num}`}>
            <h2 class="pcc-cap-page__h2" id={`cap-enlaces-${num}`}>
              Enlaces útiles
            </h2>
            <ul class="pcc-ul">
              {detalle.enlacesUtiles.map((en) => (
                <li>
                  <a class="pcc-a" href={en.url} target="_blank" rel="noopener noreferrer">
                    {en.etiqueta} ↗
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <section class="pcc-cap-page__section pcc-cap-page__fotos" aria-labelledby={`cap-fotos-${num}`}>
        <h2 class="pcc-cap-page__h2" id={`cap-fotos-${num}`}>
          Fotos nuestras
        </h2>
        {
          detalle.fotos.length > 0 ? (
            <div class="pcc-shots pcc-shots--large">
              {detalle.fotos.map((src, j) => (
                <figure class="pcc-shot" title="Clic para ampliar; en el visor usá flechas o deslizá el dedo">
                  <img src={src} alt={`${tituloOficial}, foto ${j + 1}`} loading="lazy" width="800" height="600" referrerpolicy="no-referrer" />
                </figure>
              ))}
            </div>
          ) : (
            <p class="pcc-prose pcc-cap-page__pendiente">
              Todavía no hay fotos en este capítulo. Cuando tengan imágenes propias (cata, sendero, mesa, oficios…), agreguen rutas en{" "}
              <code class="pcc-code">src/data/capitulos-detalle.ts</code> → <code class="pcc-code">fotos</code> del capítulo {num} (archivos en{" "}
              <code class="pcc-code">public/fotos/</code>
              ).
            </p>
          )
        }
      </section>

      <nav class="pcc-cap-page__pager" aria-label="Capítulos anterior y siguiente">
        {
          num > 1 && (
            <a class="pcc-btn pcc-btn--outline" href={`/capitulo/${num - 1}`}>
              ← Cap. {num - 1}
            </a>
          )
        }
        {
          num < 8 && (
            <a class="pcc-btn pcc-btn--accent" href={`/capitulo/${num + 1}`}>
              Cap. {num + 1} →
            </a>
          )
        }
        <a class="pcc-cap-page__volver pcc-a" href={`/#cap-${num}`}>
          Volver al resumen en portada
        </a>
      </nav>
    </div>
  </main>

  <SiteFooter
    brand={nombreSitio}
    brandHref="/"
    tagline={`${guia.lema} Por ${meta.autores ?? ""}.`}
    year={year}
    officialLinks={officialFootLinks}
    siteLinks={siteFootLinks}
    disclaimer="Diario personal — no es publicación institucional del PCC."
  />
</Layout>
