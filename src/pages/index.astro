---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteHero from "../components/SiteHero.astro";
import CtaBand from "../components/CtaBand.astro";
import SiteFooter from "../components/SiteFooter.astro";
import VisitaCuaderno from "../components/VisitaCuaderno.astro";
import MejoresLugaresHome from "../components/MejoresLugaresHome.astro";
import MapaRutas from "../components/MapaRutas.astro";
import { rutas } from "../data/rutas";
import { rutasMapa } from "../data/rutas-mapa";
import { slugMunicipio } from "../lib/slug-municipio";
import { withBase } from "../lib/base";

const { meta, guia, visitados, ilustraciones, municipiosPcc } = rutas;
const nombreSitio = meta.titulo ?? "Mil rutas un destino";
const slugsConVisita = new Set(
  visitados.map((v) => (typeof v.slug === "string" && v.slug.length > 0 ? v.slug : slugMunicipio(v.municipio))),
);
const pageTitle = `${nombreSitio} · ${meta.subtitulo ?? "Recuerdos de viaje"}`;
const pageDescription =
  "Mil rutas un destino — diario de Santiago y Esmeralda: lugares, fotos, rutas y lo que vivimos juntos.";

const navLinks = [
  { label: "Intro", href: "#introduccion" },
  { label: "Lugares", href: "#municipios" },
  { label: "Rutas", href: "#rutas" },
  { label: "Favoritos", href: "#destacados" },
  { label: "Bitácora", href: "#bitacora" },
];

const year = new Date().getFullYear();

const officialFootLinks = [
  { label: "Portal Paisaje Cultural Cafetero", href: "https://paisajeculturalcafetero.org.co/", external: true },
  { label: "Listado UNESCO", href: "https://whc.unesco.org/en/list/1121/", external: true },
];

const siteFootLinks = [
  { label: "Portada", href: "#portada" },
  { label: "Introducción", href: "#introduccion" },
  { label: "Lugares", href: "#municipios" },
  { label: "Rutas", href: "#rutas" },
  { label: "Favoritos", href: "#destacados" },
  { label: "Bitácora", href: "#bitacora" },
];
---

<Layout title={pageTitle} description={pageDescription} ogImage={ilustraciones.hero.src}>
  <a class="pcc-skip" href="#introduccion">Saltar al contenido</a>

  <SiteHeader brand={nombreSitio} links={navLinks} ctaLabel="Bitácora" ctaHref="#bitacora" />

  <SiteHero
    topper={guia.heroTopper}
    brandLine={nombreSitio}
    quote={guia.heroQuote}
    description={guia.introPersonal}
    tagline={guia.heroTagline}
    metaLine={guia.heroMeta?.trim() ? guia.heroMeta : meta.puntoPartida ?? ""}
    primaryLabel="Ir a la bitácora"
    primaryHref="#bitacora"
    secondaryLabel="Ver rutas"
    secondaryHref="#rutas"
    imageSrc={ilustraciones.hero.src}
    imageAlt={ilustraciones.hero.alt}
  />

  <main class="pcc-main" id="contenido">
    <article class="pcc-article pcc-article--intro-panel" id="introduccion">
      <div class="pcc-container pcc-article__shell">
        <header class="pcc-section-head">
          <span class="pcc-kicker">Empezá por acá</span>
          <h2 class="pcc-h2 pcc-h2--section">Qué es este cuaderno</h2>
          <p class="pcc-section-dek">
            A dónde fuimos, qué hicimos, qué nos gustó y las fotos del día.
          </p>
        </header>
        <div class="pcc-article__inner pcc-article__inner--intro">
          <div class="pcc-intro__copy">
            <h3 class="pcc-h3 pcc-h3--muted">De qué va</h3>
            <p class="pcc-prose pcc-prose--large">{guia.introPersonal}</p>
            <p class="pcc-prose">{guia.introUnesco}</p>
            <h3 class="pcc-h3">Cómo se lee</h3>
            <ul class="pcc-ul pcc-ul--check">
              {guia.comoLeer.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
          </div>
          <figure class="pcc-intro__fig">
            <img
              src={ilustraciones.introduccion.src}
              alt={ilustraciones.introduccion.alt}
              width="900"
              height="1200"
              loading="lazy"
              decoding="async"
              referrerpolicy="no-referrer"
            />
          </figure>
        </div>
      </div>
    </article>

    <section class="pcc-muni" id="municipios" aria-labelledby="municipios-h2">
      <div class="pcc-muni__inner pcc-container">
        <header class="pcc-muni__head">
          <span class="pcc-kicker">Mapa vivo</span>
          <h2 class="pcc-h2 pcc-h2--section" id="municipios-h2">Lugares del eje (y más)</h2>
          <p class="pcc-prose pcc-prose--center pcc-muni__lead">
            Tocá un nombre para la ficha. Los que ya visitamos se marcan. Lo vivido, con fotos y nota, está en la{" "}
            <a class="pcc-a" href="#bitacora">bitácora</a>.
          </p>
        </header>

        <div class="pcc-muni__nuestras" id="nuestras-fotos">
          <div class="pcc-muni__nuestras-inner">
            <h3 class="pcc-h3 pcc-h3--muted">Recuerdos sobre el mapa</h3>
            <p class="pcc-prose pcc-muni__nuestras-prose">
              Cuando vamos a un pueblo o a otro rincón, lo sumamos a la bitácora con fotos y una nota corta: qué hicimos, qué
              nos gustó, qué repetiríamos. Así el mapa deja de ser solo nombres y se llena de vida.
            </p>
          </div>
        </div>

        <div class="pcc-muni__cols">
          {
            municipiosPcc.map((bloque) => (
              <div class="pcc-muni__card">
                <h3 class="pcc-muni__depto">{bloque.departamento}</h3>
                <p class="pcc-muni__count">{bloque.municipios.length} en el listado base</p>
                <ul class="pcc-muni__chips" aria-label={`Lugares en ${bloque.departamento}`}>
                  {bloque.municipios.map((nombre) => (
                    <li>
                      <a
                        class:list={[
                          "pcc-muni__chip",
                          "pcc-muni__chip--link",
                          slugsConVisita.has(slugMunicipio(nombre)) && "pcc-muni__chip--visitado",
                        ]}
                        href={withBase(`/municipio/${slugMunicipio(nombre)}`)}
                      >
                        {nombre}
                      </a>
                    </li>
                  ))}
                  {bloque.municipiosCuaderno?.map((nombre) => (
                    <li>
                      <a
                        class:list={[
                          "pcc-muni__chip",
                          "pcc-muni__chip--link",
                          "pcc-muni__chip--cuaderno",
                          slugsConVisita.has(slugMunicipio(nombre)) && "pcc-muni__chip--visitado",
                        ]}
                        href={withBase(`/municipio/${slugMunicipio(nombre)}`)}
                        title="Lo sumamos al cuaderno aunque no esté en el listado base del núcleo."
                      >
                        {nombre}
                        <span class="pcc-muni__chip-tag">Nuestro</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <MapaRutas rutas={rutasMapa} />

    <MejoresLugaresHome visitados={visitados} />

    <CtaBand
      title="El viaje sigue en la bitácora"
      description="Cuando bajamos del mirador o de la finca, el mejor cierre es una entrada con fecha, olores, platos y fotos. Ahí vive el recuerdo."
      primaryLabel="Ver bitácora"
      primaryHref="#bitacora"
      secondaryLabel="Ver rutas"
      secondaryHref="#rutas"
    />

    <section class="pcc-bit" id="bitacora">
      <figure class="pcc-bit__mast">
        <img
          src={ilustraciones.bitacora.src}
          alt={ilustraciones.bitacora.alt}
          width="2000"
          height="640"
          loading="lazy"
          decoding="async"
          referrerpolicy="no-referrer"
        />
      </figure>
      <div class="pcc-bit__head pcc-container">
        <span class="pcc-kicker">Memorias</span>
        <h2 class="pcc-h2 pcc-h2--section pcc-h2--on-dark">Bitácora · a dónde fuimos</h2>
        <p class="pcc-bit__intro">
          Fecha, sensaciones, qué hicimos y fotos. Sin prisa: cada salida puede sumar una entrada nueva.
        </p>
      </div>
      <div class="pcc-bit__inner pcc-container">
        <div class="pcc-cards">
          {
            visitados.length === 0 ? (
              <div class="pcc-empty pcc-empty--bit">
                <p class="pcc-empty__title">Aún no hay recuerdos publicados</p>
                <p class="pcc-empty__text">
                  Empieza vacío a propósito. Cada lugar que conozcan puede tener fotos y una anécdota acá.
                </p>
              </div>
            ) : (
              visitados.map((v, i) => <VisitaCuaderno visita={v} index={i} variant="bitacora" />)
            )
          }
        </div>
      </div>
    </section>
  </main>

  <SiteFooter
    brand={nombreSitio}
    tagline={`${guia.lema} Por ${meta.autores ?? ""}. Cuaderno personal — solo el gusto de recordar.`}
    year={year}
    officialLinks={officialFootLinks}
    siteLinks={siteFootLinks}
    disclaimer="Diario personal de viajes en pareja. No es una guía institucional."
  >
    <p slot="credit">
      Algunas imágenes de ambiente provienen de{" "}
      <a class="pcc-a" href="https://commons.wikimedia.org/wiki/Category:Paisaje_Cultural_Cafetero" target="_blank" rel="noopener noreferrer">
        Wikimedia Commons
      </a>
      . Las fotos de cada parada son nuestras.
    </p>
  </SiteFooter>
</Layout>
